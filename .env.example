# Minecraft server. Run the bot on the same Tencent Cloud host when possible.
MC_HOST=127.0.0.1
MC_PORT=25565
MC_USERNAME=AI_Player
MC_AUTH=offline
# Leave empty to auto-detect the server protocol version.
MC_VERSION=
MC_OWNER=FuQiang
MC_RECONNECT_DELAY_MS=5000

# true when launched as a Demiurge stdio MCP child. In this mode stdout is
# reserved for JSON-RPC and the Mineflayer project never calls an LLM itself.
MCP_STDIO=false

# Standalone-mode OpenAI-compatible planner API. Ignored in MCP mode.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5-mini
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2
# Use mock to verify the complete system without an API key.
LLM_MODE=api

# Runtime and safety.
DATA_DIR=./data
LOG_LEVEL=info
PLANNER_HEARTBEAT_MS=20000
SKILL_DEFAULT_TIMEOUT_MS=120000
MAX_PLAN_STEPS=20
MAX_ACTION_DISTANCE=128
ALLOW_PVP=false
ALLOW_DROP_ITEMS=true
AUTO_RESUME=true
HEALTH_PORT=3008

# Optional vision/VLM plugin. It stays disabled until a frame source is attached.
VISION_ENABLED=false
# HTTP endpoint exposed by an off-screen renderer or client Mod.
VISION_FRAME_URL=
VISION_INTERVAL_MS=1000
VISION_RESIDUAL_THRESHOLD=32
VISION_MIN_REGION_PIXELS=64
VLM_ENABLED=false
VLM_MODEL=
